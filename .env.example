# YouTube Data API v3 key (Google Cloud > Credentials > API key, restricted to YouTube Data API v3)
YOUTUBE_API_KEY=

# Contact form (https://resend.com > API Keys). Without a verified domain, Resend only delivers
# from onboarding@resend.dev to the address the Resend account was registered with.
NUXT_RESEND_API_KEY=
NUXT_CONTACT_TO=
